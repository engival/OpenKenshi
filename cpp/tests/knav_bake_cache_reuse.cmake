# knav_bake_cache_reuse (kenshi-k16.15.47): a cached bake and an uncached bake into the same output must both succeed,
# and the shared cache entry's bytes must not change. Args: BAKE (knav_bake), WORK (scratch dir).
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run)
	execute_process(COMMAND ${BAKE} ${ARGN} RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
	if(NOT rc EQUAL 0)
		message(FATAL_ERROR "knav_bake ${ARGN}: exit ${rc}\n${err}")
	endif()
endfunction()

function(entry_sum out)
	file(GLOB_RECURSE files "${WORK}/cache/*/data/*")
	set(all "")
	foreach(f IN LISTS files)
		file(SHA256 "${f}" h)
		string(APPEND all "${f} ${h}\n")
	endforeach()
	set(${out} "${all}" PARENT_SCOPE)
endfunction()

# Single file: cached, then uncached, then the reverse order into a second path.
set(zones --zones 19 31 19 31 --threads 2)
run(${zones} --cache ${WORK}/cache --out ${WORK}/a.knav)
entry_sum(before)
if(before STREQUAL "")
	message(FATAL_ERROR "no cache entry was written")
endif()
run(${zones} --no-cache --out ${WORK}/a.knav)
entry_sum(after)
if(NOT before STREQUAL after)
	message(FATAL_ERROR "single: the uncached bake changed the cache entry")
endif()
run(${zones} --no-cache --out ${WORK}/b.knav)
run(${zones} --cache ${WORK}/cache --out ${WORK}/b.knav)
entry_sum(after)
if(NOT before STREQUAL after)
	message(FATAL_ERROR "single: the cached bake over an uncached file changed the cache entry")
endif()

# World: one region, same two orders, plus a stale region file that the entry does not have.
set(world --regions 4 7 4 7 --threads 2)
run(--world ${WORK}/w1 ${world} --cache ${WORK}/cache)
entry_sum(before)
run(--world ${WORK}/w1 ${world} --no-cache)
entry_sum(after)
if(NOT before STREQUAL after)
	message(FATAL_ERROR "world: the uncached bake changed the cache entry")
endif()
file(WRITE ${WORK}/w1/region_9_9.knav "stale")
run(--world ${WORK}/w1 ${world} --cache ${WORK}/cache)
if(EXISTS ${WORK}/w1/region_9_9.knav)
	message(FATAL_ERROR "world: a stale region survived the cache hit")
endif()
run(--world ${WORK}/w2 ${world} --no-cache)
run(--world ${WORK}/w2 ${world} --cache ${WORK}/cache)
entry_sum(after)
if(NOT before STREQUAL after)
	message(FATAL_ERROR "world: the cached bake over uncached files changed the cache entry")
endif()
file(REMOVE_RECURSE "${WORK}")
