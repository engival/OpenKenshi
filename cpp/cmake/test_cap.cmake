# The 15 s test cap, part 1 (kenshi-k16.15.55; docs/INTENT.md, docs/RUNBOOK.md "Test cap"). Included right after enable_testing():
# redefines add_test(NAME ... COMMAND ...) so every later test runs under tools/test_cpu_wrap.py, which appends the test's CPU seconds
# (user+sys of its process tree) to ${KSIM_TEST_CPU_LOG}. (TEST_LAUNCHER does not do this: CMake reads it from targets only, and several
# tests run `cmake -P` scripts.) Part 2, the check test, is at the end of CMakeLists.txt. Without Python or on Windows: plain add_test.
find_package(Python3 COMPONENTS Interpreter)
set(KSIM_TEST_CPU_LOG ${CMAKE_BINARY_DIR}/test_cpu.tsv)
if(Python3_Interpreter_FOUND AND NOT WIN32)
	set(KSIM_TEST_CAP ON)
else()
	set(KSIM_TEST_CAP OFF)
endif()
function(add_test)
	if(NOT KSIM_TEST_CAP OR NOT "${ARGV0}" STREQUAL "NAME")
		_add_test(${ARGV})
		return()
	endif()
	set(out "")
	set(wrap_next OFF)
	math(EXPR last "${ARGC} - 1")
	foreach(i RANGE ${last})
		set(a "${ARGV${i}}")
		if(wrap_next)
			list(APPEND out ${Python3_EXECUTABLE} -I ${CMAKE_SOURCE_DIR}/../tools/test_cpu_wrap.py ${ARGV1} ${KSIM_TEST_CPU_LOG})
			if(TARGET "${a}")
				set(a "$<TARGET_FILE:${a}>")
			endif()
			set(wrap_next OFF)
		endif()
		list(APPEND out "${a}")
		if(a STREQUAL "COMMAND")
			set(wrap_next ON)
		endif()
	endforeach()
	_add_test(${out})
endfunction()
