# Writes OUT (a one-function .cpp holding the git hash) when the hash changed. Run at build time by the ksim_build_info target:
#   cmake -DSRC_DIR=<repo> -DOUT=<file> -P build_info.cmake
# "unknown" without git or outside a work tree (a release export): never an error.
find_program(KSIM_GIT git)
set(hash "")
if(KSIM_GIT AND EXISTS "${SRC_DIR}/../.git")
	execute_process(COMMAND "${KSIM_GIT}" rev-parse --short=8 HEAD
		WORKING_DIRECTORY "${SRC_DIR}"
		OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(NOT hash)
	set(hash "unknown")
endif()
file(WRITE "${OUT}.tmp" "// Generated by cmake/build_info.cmake at build time; do not edit.
#include \"ksim/save/scenario_run.hpp\"

namespace ksim::simlink {

std::string_view buildHash()
{
	return \"${hash}\";
}

} // namespace ksim::simlink
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
