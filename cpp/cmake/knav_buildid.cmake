# knav_bake cache key, part 2 (kenshi-k16.15.45): everything that changes the bake's bytes without touching a hashed source.
# Written to <build>/knav_bake_gen/buildid.txt at generate time (file(GENERATE) rewrites it only when the text changes), and
# hashed into KNAV_BAKE_SRC_HASH by knav_srchash.cmake. Include it after knav_bake and its libraries exist.
# Covers: compiler id + version, build type, the CXX flag variables, the directory's compile definitions/options, each of
# knav_bake / knav / kworld / kutil / kdata / Recast / Detour's compile options + definitions (generator expressions resolved),
# and the Recast/Detour version (a system package: its library file's SHA256 and version; fetched: SHA256 of its sources).
# cpp/CMakeLists.txt itself is NOT hashed (it changes with every added test): nothing in it reaches the bake's bytes except
# through the values below and the source globs knav_srchash.cmake hashes.
set(KNAV_ID "compiler ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION} std ${CMAKE_CXX_STANDARD}\n")
string(APPEND KNAV_ID "build ${CMAKE_BUILD_TYPE}\nflags ${CMAKE_CXX_FLAGS}\n")
string(APPEND KNAV_ID "flags_debug ${CMAKE_CXX_FLAGS_DEBUG}\nflags_release ${CMAKE_CXX_FLAGS_RELEASE}\n")
string(APPEND KNAV_ID "flags_relwithdebinfo ${CMAKE_CXX_FLAGS_RELWITHDEBINFO}\nflags_minsizerel ${CMAKE_CXX_FLAGS_MINSIZEREL}\n")
string(APPEND KNAV_ID "ldflags ${CMAKE_EXE_LINKER_FLAGS}\n")
get_directory_property(dirDefs COMPILE_DEFINITIONS)
get_directory_property(dirOpts COMPILE_OPTIONS)
string(APPEND KNAV_ID "dir_defs ${dirDefs}\ndir_opts ${dirOpts}\n")
foreach(t knav_bake knav kworld kutil kdata Detour)
	if(TARGET ${t})
		get_target_property(aliased ${t} ALIASED_TARGET)
		if(aliased)
			set(real ${aliased})
		else()
			set(real ${t})
		endif()
		get_target_property(imported ${real} IMPORTED)
		if(NOT imported)
			string(APPEND KNAV_ID "target ${t} opts $<TARGET_PROPERTY:${real},COMPILE_OPTIONS> defs $<TARGET_PROPERTY:${real},COMPILE_DEFINITIONS>"
				" iopts $<TARGET_PROPERTY:${real},INTERFACE_COMPILE_OPTIONS> idefs $<TARGET_PROPERTY:${real},INTERFACE_COMPILE_DEFINITIONS>\n")
		endif()
	endif()
endforeach()
foreach(t Recast Detour)
	if(TARGET RecastNavigation::${t})
		get_target_property(aliased RecastNavigation::${t} ALIASED_TARGET)
		set(real RecastNavigation::${t})
		if(aliased)
			set(real ${aliased})
		endif()
		get_target_property(imported ${real} IMPORTED)
		if(imported)
			set(lib "")
			foreach(prop IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_NOCONFIG IMPORTED_LOCATION_DEBUG)
				get_target_property(p ${real} ${prop})
				if(p AND EXISTS "${p}")
					set(lib "${p}")
					break()
				endif()
			endforeach()
			if(lib)
				file(SHA256 "${lib}" libhash)
			else()
				set(libhash "no-library-file")
			endif()
			string(APPEND KNAV_ID "recast ${t} system ${recastnavigation_VERSION} ${libhash}\n")
		else()
			get_target_property(srcs ${real} SOURCES)
			get_target_property(sdir ${real} SOURCE_DIR)
			set(all "")
			list(SORT srcs)
			foreach(s ${srcs})
				if(NOT IS_ABSOLUTE "${s}")
					set(s "${sdir}/${s}")
				endif()
				file(SHA256 "${s}" h)
				string(APPEND all "${h}")
			endforeach()
			string(SHA256 sum "${all}")
			string(APPEND KNAV_ID "recast ${t} fetched ${sum}\n")
		endif()
	endif()
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/knav_bake_gen/buildid.txt" CONTENT "${KNAV_ID}")
