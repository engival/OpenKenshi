# Writes githash.cpp for kclient (run by the kclient_githash target on every build, and once at configure so the file exists before the
# first compile): --help shows the hash and every playtest run records it. "-dirty" counts tracked files under client/ only: the shared
# tree always holds other sessions' uncommitted work outside it. A tree without git says "unknown". The file is rewritten only when the
# text changes, so an unchanged hash leaves its timestamp alone and rebuilds nothing.
if(NOT DEFINED SRC OR NOT DEFINED OUT)
	message(FATAL_ERROR "usage: cmake -DSRC=<client source dir> -DOUT=<githash.cpp> -P githash.cmake")
endif()
execute_process(COMMAND git rev-parse --short=8 HEAD WORKING_DIRECTORY "${SRC}"
	OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR NOT hash)
	set(hash "unknown")
else()
	execute_process(COMMAND git diff-index --quiet HEAD -- . WORKING_DIRECTORY "${SRC}" RESULT_VARIABLE dirty)
	if(dirty)
		string(APPEND hash "-dirty")
	endif()
endif()
set(text "// Generated by tools/githash.cmake (the kclient_githash target): do not edit.\nconst char* kclient_git_hash()\n{\n\treturn \"${hash}\";\n}\n")
if(EXISTS "${OUT}")
	file(READ "${OUT}" old)
else()
	set(old "")
endif()
if(NOT old STREQUAL text)
	file(WRITE "${OUT}" "${text}")
endif()
